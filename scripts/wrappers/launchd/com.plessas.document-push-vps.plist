<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the Mac that holds the OneDrive tree. launchd expands neither ~ nor
  $HOME, so install it with the placeholder replaced:

    install -m 755 scripts/wrappers/launchd/push-documents-to-vps.sh ~/.local/bin/
    sed -e "s|__HOME__|$HOME|g" scripts/wrappers/launchd/com.plessas.document-push-vps.plist \
      > ~/Library/LaunchAgents/com.plessas.document-push-vps.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.plessas.document-push-vps.plist

  /bin/zsh, not bash: zsh holds Full Disk Access on this Mac, which reading the
  OneDrive tree from a LaunchAgent needs. Every 6 hours; the wrapper writes its own log.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.plessas.document-push-vps</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__HOME__/.local/bin/push-documents-to-vps.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>21600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/document-push-vps.out</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/document-push-vps.err</string>
</dict>
</plist>
