# second-brain configuration — copy to .env and fill in.
# Only identity + one extraction path (Vertex, Gemini, or the opt-in Anthropic API) is required.

# ── Identity (used in extraction prompts + stale-thread detection) ──
BRAIN_USER_NAME="Your Name"
BRAIN_USER_ROLE="Your role or title"
# Every address you send from, primary and aliases, comma separated, each matched
# whole and case-blind (an entry without a domain is that local part at any domain):
BRAIN_USER_EMAIL_PATTERN="you@example.com,alias@example.com"

# ── Extraction engine ──
# Comments sit on their own line throughout: systemd's EnvironmentFile= keeps
# anything after the value, an inline "# ..." included, as part of the value.
# "claude" (default) or "gemini":
BRAIN_EXTRACT_ENGINE=claude
# Required with the claude engine, and no default: a model your Vertex project
# allows (or set VERTEX_MODEL_EXTRACT), with its region in the Vertex block below.
# CLAUDE_EXTRACT_MODEL=
# BRAIN_GEMINI_MODEL=gemini-2.5-flash
# Override for Teams thread extraction:
# BRAIN_TEAMS_MODEL=
# A long attachment text (over 50,000 characters, spreadsheets aside) is summarised
# in 40,000-character parts: every part while it has at most this many (8 is about
# 100 pages), three above that. 0 takes three from every long text:
# BRAIN_ATTACHMENT_FULL_PARTS_UPTO=8

# ── Vertex AI (preferred: Application Default Credentials, no API key) ──
# Model/region pairing matters and a mismatch returns HTTP 429, not a clear error:
# Claude 4.7+ needs "eu"; 4.6 and older need "europe-west1". Flip BOTH together.
# Neither the model nor the region has a default: the claude engine stops at its
# first call, naming them, until both are set.
# Or ANTHROPIC_VERTEX_PROJECT_ID:
# VERTEX_SDK_PROJECT=your-gcp-project
# Or CLOUD_ML_REGION:
# VERTEX_SDK_REGION=
# Optional, no default: retry a policy refusal once on this pair, set both or neither:
# VERTEX_MODEL_FALLBACK_SDK=
# Must match the FALLBACK model's tier:
# VERTEX_REGION_FALLBACK=
# gemini-embedding-001 is served here:
# VERTEX_REGION_EMBED=europe-west1

# ── Alternative credentials ──
# Direct Anthropic API, used only when no Vertex project is set (Vertex wins
# whenever VERTEX_SDK_PROJECT or ANTHROPIC_VERTEX_PROJECT_ID is present), and only
# with BRAIN_ALLOW_DIRECT_API=1 as well: a key alone never sends mail text there.
# ANTHROPIC_API_KEY=sk-ant-...
# BRAIN_ALLOW_DIRECT_API=
# Required when BRAIN_EXTRACT_ENGINE=gemini:
# GEMINI_API_KEY=...

# ── Paths and hosts ──
# Tenant you hold a session for:
# SHAREPOINT_HOST=contoso.sharepoint.com
# SECOND_BRAIN_VENV_PYTHON=/abs/path/.venv/bin/python
# Absolute paths to the external M365 adapters. Set these for any process that
# does not inherit an interactive shell's PATH (MCP servers, launchd, systemd):
# OUTLOOK_CLI_PATH=/abs/path/to/outlook-cli
# SHAREPOINT_CLI_PATH=/abs/path/to/sharepoint-access/dist/cli.js

# ── Data home (DB + all ingested data live here) ──
# Use an ABSOLUTE path, not "~". A shell expands the tilde; systemd's
# EnvironmentFile= and launchd's EnvironmentVariables do not, and the result is a
# literal directory named "~" in the working directory.
# Default: <repo>/data. Point at a stable, checkout-independent path for
# scheduled runs:
# BRAIN_DATA_DIR=/home/you/.second-brain/data

# ── Scheduling / deployment (see docs/DEPLOY.md) ──
# Repo your scheduled wrappers cd into:
# BRAIN_REPO=/abs/path/to/plessas-second-brain
# launchd label prefix (macOS):
# BRAIN_LABEL_PREFIX=com.secondbrain
# Nightly health-check recipient:
# HEALTH_EMAIL_TO=you@example.com
