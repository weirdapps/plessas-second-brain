# second-brain configuration — copy to .env and fill in.
# Only identity + one extraction path (Vertex OR Anthropic API OR Gemini) is required.

# ── Identity (used in extraction prompts + stale-thread detection) ──
BRAIN_USER_NAME="Your Name"
BRAIN_USER_ROLE="Your role or title"
# Case-insensitive substring matched against sender_address to detect your sent mail:
BRAIN_USER_EMAIL_PATTERN="yourname"

# ── Extraction engine ──
BRAIN_EXTRACT_ENGINE=claude            # "claude" (default) or "gemini"
# CLAUDE_EXTRACT_MODEL=claude-sonnet-4-6
# BRAIN_GEMINI_MODEL=gemini-2.5-flash
# BRAIN_TEAMS_MODEL=                   # override for Teams thread extraction

# ── Vertex AI (preferred: Application Default Credentials, no API key) ──
# Model/region pairing matters and a mismatch returns HTTP 429, not a clear error:
# Claude 4.7+ needs "eu"; 4.6 and older need "europe-west1". Flip BOTH together.
# The fallback pair below used to read claude-opus-5 + europe-west1, which is that
# exact mismatch, two lines under this warning: a policy refusal would have
# downgraded straight into a quota error.
# VERTEX_SDK_PROJECT=your-gcp-project          # or ANTHROPIC_VERTEX_PROJECT_ID
# VERTEX_SDK_REGION=europe-west1               # or CLOUD_ML_REGION
# VERTEX_MODEL_FALLBACK_SDK=claude-opus-5      # auto-downgrade on policy refusal
# VERTEX_REGION_FALLBACK=eu                    # must match the FALLBACK model's tier
# VERTEX_REGION_EMBED=europe-west1             # gemini-embedding-001 is served here

# ── Alternative credentials ──
# ANTHROPIC_API_KEY=sk-ant-...          # direct Anthropic API; wins if set
# GEMINI_API_KEY=...                    # required when BRAIN_EXTRACT_ENGINE=gemini

# ── Paths and hosts ──
# SHAREPOINT_HOST=contoso.sharepoint.com          # tenant you hold a session for
# SECOND_BRAIN_VENV_PYTHON=/abs/path/.venv/bin/python
# Absolute paths to the external M365 adapters. Set these for any process that
# does not inherit an interactive shell's PATH (MCP servers, launchd, systemd):
# OUTLOOK_CLI_PATH=/abs/path/to/outlook-cli
# SHAREPOINT_CLI_PATH=/abs/path/to/sharepoint-access/dist/cli.js

# ── Data home (DB + all ingested data live here) ──
# Use an ABSOLUTE path, not "~". A shell expands the tilde; systemd's
# EnvironmentFile= and launchd's EnvironmentVariables do not, and the result is a
# literal directory named "~" in the working directory.
# BRAIN_DATA_DIR=/home/you/.second-brain/data   # default: <repo>/data. Point at a
#                                       # stable, checkout-independent path for
#                                       # scheduled runs.

# ── Scheduling / deployment (see docs/DEPLOY.md) ──
# BRAIN_REPO=/abs/path/to/plessas-second-brain  # repo your scheduled wrappers cd into
# BRAIN_LABEL_PREFIX=com.secondbrain            # launchd label prefix (macOS)
# HEALTH_EMAIL_TO=you@example.com               # nightly health-check recipient
